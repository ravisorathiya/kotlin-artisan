package {{PACKAGE}}

import android.content.Context
import android.os.Bundle
import com.ogmediaapps.eventbox.OGEventBoxLog
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.launch
import timber.log.Timber

/*
 * firebaseEvent: every analytics event of the app goes through here (added by `artisan make:analytics`).
 * Every event is listed in ai/.../event/event.md (`artisan make:event` adds the row, `artisan check:events` compares).
 * Names: snake_case, under 30 characters, `<screen>_<thing>_<action>`. Switches and bypass rules: DebugConfig.
 */

/**
 * Logs [name] to Firebase Analytics, logcat (debug builds) and, when it's on, the event box.
 * Callable from anywhere: an Activity, a Fragment, a ViewModel, an ad SDK callback on a background thread.
 */
fun firebaseEvent(name: String, bundle: Bundle = Bundle()) = logEvent(name, bundle)

/** Same as [firebaseEvent]; kept for code that calls `context.firebaseEvent(...)`. */
@Suppress("UnusedReceiverParameter")
fun Context.firebaseEvent(name: String, bundle: Bundle = Bundle()) = logEvent(name, bundle)

private fun logEvent(name: String, bundle: Bundle) {
    try {
        Analytics.firebaseAnalytics?.logEvent(name, bundle)
        if (Analytics.debuggable) {
            Timber.tag(DebugConfig.TAG_EVENT).i(name)
            if (!EVENT_NAME.matches(name) || name.length >= 30) {
                Timber.tag(DebugConfig.TAG_EVENT).w("'%s' breaks the naming rule: snake_case, under 30 characters", name)
            }
        }
        if (DebugConfig.ENABLE_EVENT_BOX && !isBypassed(name)) showInEventBox(name, bundle)
    } catch (e: Exception) {
        logging("firebaseEvent", e)
    }
}

/** The naming rule: snake_case, starting with a letter. */
private val EVENT_NAME = Regex("^[a-z][a-z0-9]*(_[a-z0-9]+)*$")

/** True when [name] stays out of the box (DebugConfig's bypass rules). */
internal fun isBypassed(name: String): Boolean = with(DebugConfig) {
    if (!EVENT_BOX_BYPASS || name in ALWAYS_SHOW) return false
    if (name in BYPASS_NAMES) return true
    // splash_on_create, and older SplashAct_OnCreate / splash_onCreate names, all end in "_on_create"
    val plain = name.replace(Regex("([a-z0-9])([A-Z])"), "$1_$2").lowercase()
    BYPASS_PREFIXES.any { plain.startsWith(it.lowercase()) } || BYPASS_SUFFIXES.any { plain.endsWith(it.lowercase()) }
}

/** The box is a view: post to the main thread (ad SDK callbacks arrive on background threads). */
private fun showInEventBox(name: String, bundle: Bundle) {
    Analytics.scope.launch(Dispatchers.Main) {
        try {
            Analytics.ensureEventBox()
            OGEventBoxLog.log(name, bundle)
        } catch (e: Exception) {
            logging("firebaseEvent.box", e)
        }
    }
}
