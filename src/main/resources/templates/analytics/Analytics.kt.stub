package {{PACKAGE}}

import android.app.Application
import android.content.Context
import android.content.pm.ApplicationInfo
import com.google.firebase.analytics.FirebaseAnalytics
import com.ogmediaapps.eventbox.OGEventBoxLog

/** Firebase Analytics and the event box. Switches and firebaseEvent are in DebugConfig.kt. */
object Analytics {
    @Volatile
    private var appContext: Context? = null

    @Volatile
    private var instance: FirebaseAnalytics? = null

    /** Resolved on the first event, so FirebaseApp may be initialised after [init]. */
    internal val firebaseAnalytics: FirebaseAnalytics?
        get() = instance ?: appContext?.let { FirebaseAnalytics.getInstance(it) }?.also { instance = it }

    /** Debug build (android:debuggable): logcat lines only then. */
    internal var debuggable = false
        private set

    /** Call once from Application.onCreate(), before any Activity starts. */
    fun init(app: Application) {
        if (appContext != null) return
        appContext = app.applicationContext
        debuggable = (app.applicationInfo.flags and ApplicationInfo.FLAG_DEBUGGABLE) != 0
        try {
            OGEventBoxLog.setDebugModeEnabled(ENABLE_EVENT_BOX)
                .setDebugModeDurationHours(0.5)
                .install(app)
            OGEventBoxLog.setEnabled(app, ENABLE_EVENT_BOX)
        } catch (e: Exception) {
            logging("Analytics.init", e)
        }
    }

    /** A session ends after its duration, and an SDK sharing the box may switch it off: turn it back on while testing. */
    internal fun ensureEventBox() {
        if (!ENABLE_EVENT_BOX || OGEventBoxLog.isActive) return
        val context = appContext ?: return
        OGEventBoxLog.setDebugModeEnabled(true).setDebugModeDurationHours(0.5)
        OGEventBoxLog.setEnabled(context, true)
    }
}
