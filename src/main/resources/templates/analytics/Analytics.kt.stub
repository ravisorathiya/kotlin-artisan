package {{PACKAGE}}

import android.app.Application
import android.content.Context
import android.content.pm.ApplicationInfo
import com.google.firebase.analytics.FirebaseAnalytics
import com.google.firebase.crashlytics.FirebaseCrashlytics
import com.ogmediaapps.eventbox.OGEventBoxLog
import kotlinx.coroutines.CoroutineScope
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.SupervisorJob
import timber.log.Timber
import {{PACKAGE}}.log.logging
import {{PACKAGE}}.remote.AdsConstant
import {{PACKAGE}}.remote.RemoteConfig

/** Sets up Firebase for the app: call [init] once from Application.onCreate(). See README.md in this module. */
object Analytics {
    @Volatile
    private var appContext: Context? = null

    @Volatile
    private var instance: FirebaseAnalytics? = null

    /** For background work of this module (event box posts, Remote Config, Messaging). Never cancelled. */
    internal val scope = CoroutineScope(SupervisorJob() + Dispatchers.Default)

    /** Resolved on the first event, so FirebaseApp may be initialised after [init]. */
    internal val firebaseAnalytics: FirebaseAnalytics?
        get() = instance ?: appContext?.let { FirebaseAnalytics.getInstance(it) }?.also { instance = it }

    /** Debug build (android:debuggable): logcat output and debug-only behaviour. */
    var debuggable = false
        private set

    // ---------- Builder: optional settings, before init ----------
    // Analytics.setIcon(R.mipmap.ic_launcher).setRemoteHolders(AdsConstant, FeatureFlags).init(this)
    // Switches (event box, session hours, Crashlytics) stay in DebugConfig.

    @Volatile
    private var bubbleIcon = 0

    @Volatile
    private var holders: Array<out Any> = arrayOf(AdsConstant)

    /** The event box bubble icon, e.g. R.mipmap.ic_launcher. 0 keeps the library's icon. */
    fun setIcon(resId: Int): Analytics = apply { bubbleIcon = resId }

    /** The objects with `by remote...` properties that Remote Config fetches and applies (AdsConstant by default). */
    fun setRemoteHolders(vararg remoteHolders: Any): Analytics = apply { holders = remoteHolders }

    /**
     * Once, from Application.onCreate(), before any Activity starts, after the builder calls above. [remoteHolders]
     * given here replace [setRemoteHolders]: `Analytics.init(this, AdsConstant, FeatureFlags)`.
     */
    fun init(app: Application, vararg remoteHolders: Any) {
        if (appContext != null) return
        appContext = app.applicationContext
        debuggable = (app.applicationInfo.flags and ApplicationInfo.FLAG_DEBUGGABLE) != 0
        if (debuggable && Timber.treeCount == 0) Timber.plant(Timber.DebugTree())
        try {
            FirebaseCrashlytics.getInstance().setCrashlyticsCollectionEnabled(!debuggable || DebugConfig.CRASHLYTICS_IN_DEBUG)
        } catch (e: Exception) {
            Timber.w(e, "Crashlytics unavailable (google-services.json?)")
        }
        try {
            OGEventBoxLog.setDebugModeEnabled(DebugConfig.ENABLE_EVENT_BOX)
                .setDebugModeDurationHours(DebugConfig.EVENT_BOX_SESSION_HOURS)
                .apply { if (bubbleIcon != 0) setBubbleIconResId(bubbleIcon) }
                .install(app)
            OGEventBoxLog.setEnabled(app, DebugConfig.ENABLE_EVENT_BOX)
        } catch (e: Exception) {
            logging("Analytics.init", e)
        }
        RemoteConfig.start(*(if (remoteHolders.isNotEmpty()) remoteHolders else holders))
    }

    /** A session ends after its duration, and an SDK sharing the box may switch it off: turn it back on while testing. */
    internal fun ensureEventBox() {
        if (!DebugConfig.ENABLE_EVENT_BOX || OGEventBoxLog.isActive) return
        val context = appContext ?: return
        OGEventBoxLog.setDebugModeEnabled(true).setDebugModeDurationHours(DebugConfig.EVENT_BOX_SESSION_HOURS)
        OGEventBoxLog.setEnabled(context, true)
    }

    /** Ties events and crashes to a user (an id of your own, never an email or phone number). null clears it. */
    fun setUserId(id: String?) {
        try {
            firebaseAnalytics?.setUserId(id)
            FirebaseCrashlytics.getInstance().setUserId(id ?: "")
        } catch (e: Exception) {
            logging("Analytics.setUserId", e)
        }
    }

    /** A user property for Analytics audiences, e.g. ("theme", "dark"). */
    fun setUserProperty(name: String, value: String?) {
        try {
            firebaseAnalytics?.setUserProperty(name, value)
            if (value != null && DebugConfig.ENABLE_EVENT_BOX) OGEventBoxLog.setUserProperty(name, value)
        } catch (e: Exception) {
            logging("Analytics.setUserProperty", e)
        }
    }
}
