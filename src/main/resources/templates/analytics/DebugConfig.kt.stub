package {{PACKAGE}}

// ╔══════════════════════════════════════════════════════════════╗
// ║ 🐞 DEBUG CONFIG · every switch of the app, one file          ║
// ║ 🚀 Release → ENABLE_EVENT_BOX = false, ENABLE_LIVE_AD = true ║
// ║ 💰 Release → your app id in ADMOB_APP_ID_LIVE                ║
// ║ 📌 Keep each const val one line (read by Gradle)             ║
// ║ 🔗 auto = follows the switches, don't edit                   ║
// ╟──────────────────────────────────────────────────────────────╢
// ║ 🛡️ Release build warns when not ready (checkReleaseSwitches) ║
// ║ 🔍 Check values → logcat tag RemoteConfigAudit (debug)       ║
// ║ 📊 Events → logcat tag GlobalFirebaseEventNameTag            ║
// ║ 🐞 Debug → logcat tag GlobalAppDebugLogger                   ║
// ║ 📚 Every switch explained → README.md in this module         ║
// ╚══════════════════════════════════════════════════════════════╝
object DebugConfig {

    // region 🚦 Main
    // ┌────────────────────────────┐
    // │ 🚦 Main                    │
    // └────────────────────────────┘
    // 🎯 the two switches to flip for a Play Store release
    const val ENABLE_EVENT_BOX = true    // 📦 true = testers' event box · false = release
    const val ENABLE_LIVE_AD = false    // 💰 true = live ads, Firebase may change them · false = Google test ads
    // endregion

    // region 💰 Ads
    // ┌────────────────────────────┐
    // │ 💰 Ads                     │
    // └────────────────────────────┘
    // 🆔 AdMob app id · the manifest gets it through ${admobAppId}
    const val ADMOB_APP_ID_LIVE = ""    // 🔑 AdMob > Apps > App settings · empty = test id, release warns
    const val ADMOB_APP_ID_TEST = "ca-app-pub-3940256099942544~3347511713"    // 🧪 Google test app id
    val ADMOB_APP_ID: String get() = if (ENABLE_LIVE_AD && ADMOB_APP_ID_LIVE.isNotEmpty()) ADMOB_APP_ID_LIVE else ADMOB_APP_ID_TEST    // 🔗 auto
    // endregion

    // region 📝 Logcat
    // ┌────────────────────────────┐
    // │ 📝 Logcat                  │
    // └────────────────────────────┘
    // 🐞 debug builds only · release builds never print
    const val ENABLE_TIMBER = ENABLE_EVENT_BOX    // 🔗 auto · true = plant Timber
    val LOGGING_VOLUME = if (ENABLE_EVENT_BOX) AppLoggingVolumeEnum.FULL else AppLoggingVolumeEnum.NONE    // 🔗 auto · FULL · MEDIUM · LOW · NONE
    const val LOW_FULL_UNTIL_SCREEN = "MainActivity"    // 🔉 LOW: everything until this screen, then warnings + errors
    const val LOG_CALLER_LOCATION = true    // 📍 adds · method(File.kt:12), clickable in Studio
    const val PRINT_CONFIG_ON_START = true    // 🧾 one start-up line: QA build · ads TEST · logging FULL · ...
    const val TAG_EVENT = "GlobalFirebaseEventNameTag"    // 📊 events
    const val TAG_DEBUG = "GlobalAppDebugLogger"    // 🐞 logging(...)
    const val FAIL_RELEASE_ON_RAW_LOGS = true    // ⛔ Log.d / printStackTrace / println fail a release · false = warn
    // endregion

    // region 💥 Crashlytics
    // ┌────────────────────────────┐
    // │ 💥 Crashlytics             │
    // └────────────────────────────┘
    // 📤 release builds send caught errors + breadcrumbs
    const val RECORD_CAUGHT_ERRORS = true    // 🧯 logging(tag, e) → non-fatal
    const val CRASHLYTICS_IN_DEBUG = false    // 🐞 true = debug crashes reach the dashboard too
    const val CRASH_RECORD_MAX_PER_TAG = 3    // 🔢 non-fatals per tag per app start
    const val CRASHLYTICS_BREADCRUMBS = true    // 🍞 logging(message) + logFlow steps → breadcrumbs
    const val TRACK_SCREENS = true    // 📱 key "screen" = the Activity on screen
    // endregion

    // region 🌐 Remote Config
    // ┌────────────────────────────┐
    // │ 🌐 Remote Config           │
    // └────────────────────────────┘
    // 📡 keys live in remote/AdsConstant.kt
    const val REMOTE_CONFIG_LIVE_UPDATES = true    // ⚡ apply console changes while the app runs
    const val REMOTE_CONFIG_TIMEOUT_MILLIS = 3000L    // ⏱️ awaitFetch() waits this long, then defaults
    const val REMOTE_CONFIG_FETCH_INTERVAL_SECONDS = 3600L    // 🔁 release builds · debug always fetches
    const val REMOTE_CONFIG_AUDIT_IN_RELEASE = false    // 🔍 true = the audit table in release logcat too
    // endregion

    // region 🧩 Types
    // ┌────────────────────────────┐
    // │ 🧩 Types                   │
    // └────────────────────────────┘
    @Suppress("unused")
    enum class AppLoggingVolumeEnum { FULL, MEDIUM, LOW, NONE }    // 🔉 see README.md: what each one prints
    // endregion

    // region 📦 Event box
    // ┌────────────────────────────┐
    // │ 📦 Event box               │
    // └────────────────────────────┘
    // 🙈 left-out events still go to Firebase and logcat · names are snake_case
    const val EVENT_BOX_SESSION_HOURS = 0.5    // ⏳ the box switches itself off after this
    const val EVENT_BOX_BYPASS = true    // 🙈 false = show every event
    val BYPASS_SUFFIXES = listOf(
        // hide names ending with these (any case: _on_create also hides _OnCreate)
        "_on_create", "_on_create_view", "_on_start",
        "_on_resume", "_on_pause", "_on_stop",
        "_on_destroy", "_on_back", "_on_backpress",
        "_on_back_press", "_on_back_pressed",
    )
    val BYPASS_PREFIXES = listOf<String>()    // 🔤 e.g. "appopen_"
    val BYPASS_NAMES = setOf<String>()    // 🎯 exact names
    val ALWAYS_SHOW = setOf<String>()    // 👀 shown even when a rule above hides it
    // endregion
}
