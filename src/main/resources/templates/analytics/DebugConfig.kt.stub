package {{PACKAGE}}

/**
 * Debug switches for the whole app. Settings only: the code that uses them is in FirebaseEvents.kt and Analytics.kt.
 * See README.md in this module.
 */
object DebugConfig {

    // ---------- Event box (https://github.com/JpOriginDev/event-box) ----------

    /** Shows the floating event box on every screen, for testers. **Keep false in release builds.** */
    const val ENABLE_EVENT_BOX = false

    /** How long one event box session lasts before it switches itself off. */
    const val EVENT_BOX_SESSION_HOURS = 0.5

    // ---------- Bypass: what the box leaves out ----------
    // Left-out events still go to Firebase and logcat. Names are snake_case (<screen>_<thing>_<action>), and so are
    // these rules.

    /** false shows every event in the box. */
    const val EVENT_BOX_BYPASS = true

    /** Name endings left out: lifecycle events. Any case, so `_on_create` also matches `_OnCreate`. */
    val BYPASS_SUFFIXES = listOf(
        "_on_create",
        "_on_create_view",
        "_on_start",
        "_on_resume",
        "_on_pause",
        "_on_stop",
        "_on_destroy",
        "_on_back",
        "_on_backpress",
        "_on_back_press",
        "_on_back_pressed",
    )

    /** Name starts left out, e.g. "appopen_" for app-open ad events. */
    val BYPASS_PREFIXES = listOf<String>()

    /** Exact names left out. */
    val BYPASS_NAMES = setOf<String>()

    /** Exact names always shown, even when a rule above leaves them out, e.g. "permi_on_create". */
    val ALWAYS_SHOW = setOf<String>()

    // ---------- Logging and Crashlytics ----------

    /** Logcat tag of every event (`artisan app:logcat GlobalFirebaseEventNameTag`). */
    const val TAG_EVENT = "GlobalFirebaseEventNameTag"

    /** Logcat tag of logging(...). */
    const val TAG_DEBUG = "GlobalAppDebugLogger"

    /** Sends caught errors from logging(tag, throwable) to Crashlytics as non-fatals (release builds only). */
    const val RECORD_CAUGHT_ERRORS = true

    /** Collects Crashlytics reports from debug builds too. Off, so test crashes don't fill the dashboard. */
    const val CRASHLYTICS_IN_DEBUG = false

    // ---------- Remote Config ----------

    /** Minimum time between Remote Config fetches in release builds. Debug builds always fetch. */
    const val REMOTE_CONFIG_FETCH_INTERVAL_SECONDS = 3600L
}
